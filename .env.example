# Environment variables that DSP-TOOLS reads at runtime.
#
# DSP-TOOLS loads only a file named ".env". It never loads this file.
# To use a variable, copy it into a ".env" file in the directory where you run DSP-TOOLS,
# or set it in your shell. A variable that is already set in the shell takes precedence over the ".env" file.
#
# All variables are optional. Each variable below shows its default and its effect.
# A boolean variable counts as true only for the string "true". Any other value or no value counts as false.
#
# Documentation:
#   docs/special-workflows/env-set-up.md
#   docs/xmllib-docs/advanced-set-up.md


# ---------------------------------------------------------------------------
# create
# ---------------------------------------------------------------------------

# Password for each user in the JSON project file that has no password ("password": null).
# Default: not set. Then "create" reports an error for each user without a password.
# DSP_USER_PASSWORD=


# ---------------------------------------------------------------------------
# Logging (all commands)
# ---------------------------------------------------------------------------

# Write the values of the variables into the stack traces in the log files.
# These values can contain passwords, tokens and research data.
# Default: false
# DSP_TOOLS_LOG_VARIABLE_VALUES=true

# Write a complete "logging.log" file with stack traces into the current working directory,
# instead of the "warnings.log" file. The log file in ~/.dsp-tools/logs/ stays the same.
# Default: false. Then the current working directory gets a "warnings.log" file with warnings and errors only.
# DSP_TOOLS_SAVE_ADDITIONAL_LOG_FILE_IN_CWD=true


# ---------------------------------------------------------------------------
# Testing
# ---------------------------------------------------------------------------

# Do not retry failed requests to the DSP-API (server errors, rate limits, "try again later").
# The CI workflows set this variable so that the tests fail fast.
# Only the exact lowercase string "true" turns off the retries.
# Default: false
# DSP_TOOLS_TESTING=true


# ---------------------------------------------------------------------------
# xmllib
# ---------------------------------------------------------------------------

# Write the xmllib infos, warnings and errors into this CSV file instead of the terminal.
# An existing file at this path is overwritten.
# Default: not set. Then the messages go to the terminal.
# XMLLIB_WARNINGS_CSV_SAVEPATH=my_folder/my_file.csv

# Do not show or save xmllib warnings (wrong input, but the XML can be created).
# Default: false
# XMLLIB_IGNORE_USER_WARNING=true

# Do not show or save xmllib infos (input that is possibly wrong).
# Default: false
# XMLLIB_IGNORE_USER_INFO=true

# Sort the resources in the XML file by resource ID.
# Default: false. Then the resources keep the order in which you added them.
# XMLLIB_SORT_RESOURCES=true

# Sort the properties in the XML file by property name, and the values in each property.
# Default: false. Then the properties and values keep the order in which you added them.
# XMLLIB_SORT_PROPERTIES=true

# Give the authorship IDs consecutive integers (authorship_1, authorship_2, ...).
# Then the IDs stay the same across runs.
# Default: false. Then each run gives the authorship IDs new random UUIDs.
# XMLLIB_AUTHORSHIP_ID_WITH_INTEGERS=true
